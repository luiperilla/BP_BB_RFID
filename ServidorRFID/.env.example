# ============================================================
# Configuración del Servidor RFID
#
# Copia este archivo como ".env" en esta misma carpeta y llena los valores.
# El archivo ".env" NO se sube al repositorio (está en .gitignore): ahí van
# los datos reales del servidor de producción.
#
#     copy .env.example .env
# ============================================================

# --- Red ---------------------------------------------------
# Puerto en el que escucha el servidor. OJO: la app Android tiene el 8260
# hardcodeado; hay que actualizar el codigo Java si se cambia este valor.
PUERTO=8390

# Interfaz de escucha. 0.0.0.0 = todas las interfaces (necesario para que
# los C5 lleguen por la red). Usa 127.0.0.1 si solo pruebas en tu propia PC.
ESCUCHAR_EN=0.0.0.0

# Peticiones simultáneas que atiende waitress. 8 sobra para un puñado de C5.
HILOS=8

# --- Motor de base de datos --------------------------------
# "sqlite"    -> PRUEBA. Archivo local, no toca la base real de la empresa.
# "sqlserver" -> PRODUCCIÓN. Solo en la PC oficial, después de probar.
SQL_MOTOR=sqlite

# --- Modo prueba (solo aplica si SQL_MOTOR=sqlite) ---------
# Si es una ruta relativa, se resuelve dentro de la carpeta del servidor.
SQLITE_ARCHIVO=test_asociaciones.db

# --- Modo producción (solo aplica si SQL_MOTOR=sqlserver) --
SQL_SERVIDOR=192.168.2.23
SQL_BASE_DATOS=SmartFactory
SQL_TABLA=Hornos_Buffer_RFID

# false -> credenciales de SQL Server (usuario y contraseña de abajo). Es el
#          estándar del resto de aplicaciones, y permite acotar el acceso a un
#          login dedicado con permisos solo sobre esta tabla.
# true  -> autenticación integrada de Windows: el servicio se conecta con la
#          cuenta de dominio bajo la que corre y no hay contraseña en disco,
#          pero hereda todos los permisos de esa cuenta.
SQL_WINDOWS_AUTH=false

# Solo si SQL_WINDOWS_AUTH=false. Dejar vacíos con Windows Auth.
#
# IMPORTANTE: con credenciales, este archivo pasa a contener un secreto.
# Restringe sus permisos NTFS después de crearlo:
#     icacls .env /inheritance:r
#     icacls .env /grant "BUILTIN\Administradores:(R)" "NT AUTHORITY\SYSTEM:(R)"
SQL_USUARIO=Consulta
SQL_PASSWORD=

# Driver ODBC instalado en la PC. Comprobar en:
#   Herramientas administrativas > Orígenes de datos ODBC > pestaña Controladores
SQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# --- Otros -------------------------------------------------
# Valor que se devuelve en el spinner de modelo de la app (no se guarda en BD).
MODELO_PLACEHOLDER=N/A

# DEBUG, INFO, WARNING o ERROR. Los logs quedan en la carpeta logs/.
NIVEL_LOG=INFO
